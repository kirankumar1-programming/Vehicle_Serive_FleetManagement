{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "VehicleService.API": "Information"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=VehicleService_Api.db",
    "AzureBlobStorage": "",
    "ApplicationInsights": ""
  },
  "DatabaseProvider": "Auto",
  "Database": {
    "MaxRetryCount": 6,
    "MaxRetryDelaySeconds": 30,
    "CommandTimeoutSeconds": 60
  },
  "KeyVault": {
    "Enabled": true,
    "VaultUri": "",
    "VaultName": "",
    "ReloadIntervalMinutes": 15
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AzureBlobStorage": {
    "Enabled": true,
    "ConnectionString": "",
    "ServiceUri": "",
    "AccountName": "",
    "ContainerName": "vehicle-attachments",
    "CreateContainerIfNotExists": true,
    "PublicBlobAccess": true
  },
  "Jwt": {
    "Secret": "VehicleServiceFleetManagementSecureKey2026!#$LongEnoughForHmacSha256Signature",
    "Issuer": "VehicleServiceAPI",
    "Audience": "VehicleServiceClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "HealthChecks": {
    "MemoryThresholdMB": 2048,
    "DiskThresholdGB": 1
  }
}
