@model IReadOnlyList<InventoryTransaction>
@{
    ViewData["Title"] = "Stock Movement Ledger";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-arrow-left-right text-primary"></i> Stock Movement Ledger</h2>
            <p class="text-muted small mb-0">Immutable audit log of all inventory purchases, workshop consumptions, and returns</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Catalog</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Part</th>
                        <th>Transaction Type</th>
                        <th>Qty Changed</th>
                        <th>Before &rarr; After</th>
                        <th>Reference</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><strong>@t.InventoryPart?.Name (@t.InventoryPart?.PartNumber)</strong></td>
                            <td><span class="badge bg-secondary">@t.TransactionType</span></td>
                            <td class="fw-bold">@t.Quantity</td>
                            <td>@t.QuantityBefore &rarr; <strong>@t.QuantityAfter</strong></td>
                            <td><span class="badge bg-light text-dark border font-monospace">@t.ReferenceNumber</span></td>
                            <td class="small text-muted">@t.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>