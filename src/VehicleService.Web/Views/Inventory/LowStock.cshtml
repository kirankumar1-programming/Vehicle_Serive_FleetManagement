@model IReadOnlyList<InventoryPartDto>
@{
    ViewData["Title"] = "Low Stock Alerts";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Low-Stock Parts Monitor</h2>
            <p class="text-muted small mb-0">Spare parts currently below minimum reorder thresholds</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Catalog</a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card p-4 border-danger shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-danger font-monospace">@p.PartNumber</span>
                                <h5 class="fw-bold mt-2 mb-0">@p.Name</h5>
                                <span class="text-muted small">@p.Manufacturer</span>
                            </div>
                            <span class="badge bg-danger fs-5 px-3">@p.AvailableQuantity left</span>
                        </div>
                        <div class="small my-2 text-muted">
                            <div>Reorder Level: <strong>@p.ReorderLevel units</strong></div>
                            <div>Location: @p.WarehouseLocation</div>
                            <div>Supplier: @p.Supplier</div>
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <form asp-action="AdjustStock" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PartId" value="@p.Id" />
                                <input type="hidden" name="TransactionType" value="Purchase" />
                                <input type="hidden" name="Quantity" value="20" />
                                <input type="hidden" name="Notes" value="1-Click Emergency Restock PO" />
                                <button type="submit" class="btn btn-danger btn-sm w-100 fw-semibold">
                                    <i class="bi bi-cart-plus"></i> Reorder 20 Units
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card p-5 text-center border-0 shadow-sm">
            <i class="bi bi-shield-check fs-1 text-success mb-2"></i>
            <h4>All inventory parts are healthy</h4>
            <p class="text-muted">No spare parts are currently below their reorder threshold.</p>
        </div>
    }
</div>