@model IReadOnlyList<InventoryPartDto>
@{
    ViewData["Title"] = "Spare Parts Inventory";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-boxes text-success"></i> Spare Parts Inventory</h2>
            <p class="text-muted small mb-0">Manage stock levels, warehouse bins, reservations, and reorder thresholds</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="LowStock" class="btn btn-outline-danger btn-sm position-relative">
                <i class="bi bi-exclamation-triangle"></i> Low Stock Alerts
                @if (ViewBag.LowStockCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@ViewBag.LowStockCount</span>
                }
            </a>
            <a asp-action="Transactions" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left-right"></i> Stock Ledger</a>
            <a asp-action="AddPart" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Add New Part</a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card p-3 border-0 shadow-sm mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Search by SKU, Part Name, Manufacturer..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    <option value="Brakes">Brakes</option>
                    <option value="Fluids">Fluids & Oils</option>
                    <option value="Filters">Filters</option>
                    <option value="Electrical">Electrical & Battery</option>
                    <option value="Engine">Engine Components</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-secondary w-100"><i class="bi bi-search"></i> Filter</button>
            </div>
        </form>
    </div>

    <!-- Inventory Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Part Number</th>
                        <th>Name & Category</th>
                        <th>Location</th>
                        <th>Cost / Selling</th>
                        <th>Available Qty</th>
                        <th>Reserved</th>
                        <th>Total Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.IsLowStock ? "table-warning" : "")">
                            <td class="fw-bold font-monospace text-primary">@p.PartNumber</td>
                            <td>
                                <strong>@p.Name</strong>
                                <div class="small text-muted">@p.Category | @p.Manufacturer</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@p.WarehouseLocation</span></td>
                            <td>
                                <div>₹@p.SellingPrice.ToString("N0")</div>
                                <small class="text-muted">Cost: ₹@p.CostPrice.ToString("N0")</small>
                            </td>
                            <td>
                                <span class="badge @(p.IsLowStock ? "bg-danger" : "bg-success") fs-6">@p.AvailableQuantity</span>
                            </td>
                            <td><span class="badge bg-secondary">@p.ReservedQuantity</span></td>
                            <td class="fw-bold">@p.TotalStock</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#adjModal_@p.Id">
                                    <i class="bi bi-arrow-left-right"></i> Adjust
                                </button>

                                <!-- Stock Adjustment Modal -->
                                <div class="modal fade" id="adjModal_@p.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold">Adjust Stock: @p.Name</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="AdjustStock" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="PartId" value="@p.Id" />
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Movement Type</label>
                                                        <select name="TransactionType" class="form-select">
                                                            <option value="Purchase">Purchase / Inward Restock (+)</option>
                                                            <option value="Return">Customer / Workshop Return (+)</option>
                                                            <option value="Damage">Damaged / Written Off (-)</option>
                                                            <option value="Adjustment">Physical Count Adjustment</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Quantity</label>
                                                        <input type="number" name="Quantity" class="form-control" value="10" min="1" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Reference / Notes</label>
                                                        <input type="text" name="Notes" class="form-control" placeholder="e.g. PO-2026-0045 or Physical Audit" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Save Adjustment</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>