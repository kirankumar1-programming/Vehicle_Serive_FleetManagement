@model LoginRequest
@{
    ViewData["Title"] = "Sign In";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card p-4 shadow-lg border-0">
                <div class="text-center mb-4">
                    <i class="bi bi-car-front-fill fs-1 text-primary"></i>
                    <h3 class="fw-bold mt-2">Sign In</h3>
                    <p class="text-muted small">Access your Vehicle Service & Fleet Workspace</p>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="name@domain.com" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label class="form-check-label text-muted small" asp-for="RememberMe">Remember this browser</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">Sign In</button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-muted">
                    Don't have an account? <a asp-action="Register" class="text-primary fw-semibold">Register as Customer</a>
                </div>

                <!-- 1-Click Demo Login Shortcuts -->
                <div class="mt-4 pt-3 border-top bg-light p-3 rounded">
                    <div class="fw-bold small text-secondary mb-2"><i class="bi bi-lightning-charge-fill text-warning"></i> 1-Click Quick Demo Switchers:</div>
                    <div class="d-flex flex-wrap gap-1">
                        <form asp-action="SwitchRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="Customer" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Customer</button>
                        </form>
                        <form asp-action="SwitchRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="ServiceAdvisor" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Advisor</button>
                        </form>
                        <form asp-action="SwitchRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="Mechanic" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Mechanic</button>
                        </form>
                        <form asp-action="SwitchRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="InventoryManager" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Inventory</button>
                        </form>
                        <form asp-action="SwitchRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="FinanceManager" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Finance</button>
                        </form>
                        <form asp-action="SwitchRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="FleetManager" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Fleet</button>
                        </form>
                        <form asp-action="SwitchRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="role" value="Administrator" />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Admin</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>