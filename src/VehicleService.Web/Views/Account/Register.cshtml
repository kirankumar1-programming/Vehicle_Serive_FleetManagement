@model RegisterRequest
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card p-4 shadow border-0">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill fs-1 text-primary"></i>
                    <h3 class="fw-bold mt-2">Create Customer Account</h3>
                    <p class="text-muted small">Register to manage your vehicles, book services & track live status</p>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RoleType" value="Customer" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Ramesh Kumar" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@domain.com" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+91 98765 43210" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="At least 6 characters" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Address / City</label>
                        <input asp-for="Address" class="form-control" placeholder="123 Street Name, City" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Create Account & Proceed</button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-muted">
                    Already registered? <a asp-action="Login" class="text-primary fw-semibold">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>