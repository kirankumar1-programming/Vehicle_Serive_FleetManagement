@{
    ViewData["Title"] = "Access Denied";
}
<div class="container my-5 text-center">
    <div class="card p-5 border-0 shadow-sm max-w-600 mx-auto">
        <i class="bi bi-shield-x fs-1 text-danger mb-3"></i>
        <h3 class="fw-bold">Access Denied</h3>
        <p class="text-muted">You do not have permission to view this resource. Use the top toolbar to switch to an authorized role.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mx-auto">Return Home</a>
    </div>
</div>