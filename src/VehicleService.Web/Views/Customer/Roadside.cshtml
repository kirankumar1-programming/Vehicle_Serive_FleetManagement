@model IReadOnlyList<RoadsideRequestDto>
@{
    ViewData["Title"] = "Emergency Roadside Assistance";
    var vehicles = ViewBag.Vehicles as IReadOnlyList<VehicleDto> ?? new List<VehicleDto>();
}

<div class="container-fluid px-lg-4 my-4">
    <div class="row g-4">
        <!-- Request New Assistance Card -->
        <div class="col-lg-5">
            <div class="card p-4 border-0 shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-icon danger"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <h4 class="fw-bold mb-0">24/7 Roadside Assistance</h4>
                        <p class="text-muted small mb-0">Rapid technician & tow truck dispatch</p>
                    </div>
                </div>

                <form asp-action="RequestRoadside" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Vehicle</label>
                        <select name="VehicleId" class="form-select" required>
                            @foreach (var v in vehicles)
                            {
                                <option value="@v.Id">@v.Make @v.Model (@v.RegistrationNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Incident Type</label>
                        <select name="RequestType" class="form-select" required>
                            <option value="Breakdown">Mechanical Breakdown / Engine Failure</option>
                            <option value="FlatTyre">Flat Tyre / Puncture</option>
                            <option value="BatteryFailure">Battery Dead / Jumpstart Required</option>
                            <option value="FuelIssue">Out of Fuel / Fuel Contamination</option>
                            <option value="Towing">Flatbed Towing Required</option>
                            <option value="Accident">Accident Towing & Recovery</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Location / Landmark *</label>
                        <textarea name="LocationAddress" class="form-control" rows="2" placeholder="e.g. Near Silk Board Flyover Junction, Outer Ring Road, Bangalore" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Emergency Contact Phone *</label>
                        <input type="text" name="ContactPhone" class="form-control" placeholder="+91 98765 43210" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Describe Issue</label>
                        <input type="text" name="IssueDescription" class="form-control" placeholder="e.g. Warning lights flashing, car stopped on highway" />
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold">
                        <i class="bi bi-broadcast"></i> Dispatch Emergency Assistance
                    </button>
                </form>
            </div>
        </div>

        <!-- Active / Recent Assistance Requests -->
        <div class="col-lg-7">
            <div class="card p-4 border-0 shadow-sm h-100">
                <h4 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary"></i> Assistance Requests & Live Dispatch</h4>
                @if (Model.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var r in Model)
                        {
                            <div class="card p-3 border @(r.Status == RoadsideStatus.IssueResolved ? "bg-light" : "border-danger bg-light")">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-dark font-monospace">@r.RequestNumber</span>
                                        <span class="badge bg-danger ms-1">@r.RequestType</span>
                                        <h5 class="fw-bold mt-2 mb-0">@r.VehicleInfo</h5>
                                    </div>
                                    <span class="badge @(r.Status == RoadsideStatus.IssueResolved ? "bg-success" : "bg-danger") fs-6 px-3 py-1">
                                        @r.Status
                                    </span>
                                </div>
                                <div class="small text-muted my-1">
                                    <div><i class="bi bi-geo-alt"></i> Location: <strong>@r.LocationAddress</strong></div>
                                    <div><i class="bi bi-telephone"></i> Contact: @r.ContactPhone</div>
                                    @if (!string.IsNullOrEmpty(r.AssignedTechnicianName))
                                    {
                                        <div class="text-primary mt-1">
                                            <i class="bi bi-person-badge"></i> Assigned Patrol: <strong>@r.AssignedTechnicianName</strong> (Phone: @r.AssignedTechnicianPhone) | Tow Truck: <strong>@r.TowTruckPlate</strong>
                                        </div>
                                    }
                                </div>
                                @if (r.EstimatedArrivalTime.HasValue && r.Status != RoadsideStatus.IssueResolved)
                                {
                                    <div class="alert alert-info py-1 px-2 small mt-2 mb-0">
                                        <i class="bi bi-stopwatch"></i> Estimated Arrival: <strong>@r.EstimatedArrivalTime.Value.ToString("HH:mm")</strong>
                                    </div>
                                }
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <small class="text-muted"><i class="bi bi-calendar3"></i> Logged: @r.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#updateModal_@r.Id">
                                        <i class="bi bi-pencil-square"></i> Update Details
                                    </button>
                                </div>

                                <!-- Update Roadside Assistance Modal -->
                                <div class="modal fade" id="updateModal_@r.Id" tabindex="-1" aria-labelledby="updateModalLabel_@r.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header bg-light">
                                                <h5 class="modal-title fw-bold text-danger" id="updateModalLabel_@r.Id">
                                                    <i class="bi bi-pencil-square me-2"></i> Update Roadside Assistance - @r.RequestNumber
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-action="UpdateRoadsideRequest" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="RequestId" value="@r.Id" />
                                                <div class="modal-body">
                                                    <div class="row g-3 text-start">
                                                        <div class="col-md-6">
                                                            <label class="form-label fw-semibold">Incident Type</label>
                                                            <select name="RequestType" class="form-select" required>
                                                                <option value="Breakdown" selected="@(r.RequestType == RoadsideRequestType.Breakdown)">Mechanical Breakdown / Engine Failure</option>
                                                                <option value="FlatTyre" selected="@(r.RequestType == RoadsideRequestType.FlatTyre)">Flat Tyre / Puncture</option>
                                                                <option value="BatteryFailure" selected="@(r.RequestType == RoadsideRequestType.BatteryFailure)">Battery Dead / Jumpstart Required</option>
                                                                <option value="FuelIssue" selected="@(r.RequestType == RoadsideRequestType.FuelIssue)">Out of Fuel / Fuel Contamination</option>
                                                                <option value="Towing" selected="@(r.RequestType == RoadsideRequestType.Towing)">Flatbed Towing Required</option>
                                                                <option value="Accident" selected="@(r.RequestType == RoadsideRequestType.Accident)">Accident Towing & Recovery</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label fw-semibold">Request Status</label>
                                                            <select name="Status" class="form-select" required>
                                                                <option value="Requested" selected="@(r.Status == RoadsideStatus.Requested)">Requested</option>
                                                                <option value="AgentAssigned" selected="@(r.Status == RoadsideStatus.AgentAssigned)">Agent Assigned</option>
                                                                <option value="TechnicianDispatched" selected="@(r.Status == RoadsideStatus.TechnicianDispatched)">Technician Dispatched</option>
                                                                <option value="TechnicianArrived" selected="@(r.Status == RoadsideStatus.TechnicianArrived)">Technician Arrived</option>
                                                                <option value="InTow" selected="@(r.Status == RoadsideStatus.InTow)">In Tow to Workshop</option>
                                                                <option value="IssueResolved" selected="@(r.Status == RoadsideStatus.IssueResolved)">Issue Resolved</option>
                                                                <option value="Cancelled" selected="@(r.Status == RoadsideStatus.Cancelled)">Cancelled</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label fw-semibold">Current Location / Landmark *</label>
                                                            <input type="text" name="LocationAddress" class="form-control" value="@r.LocationAddress" required />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label fw-semibold">Emergency Contact Phone *</label>
                                                            <input type="text" name="ContactPhone" class="form-control" value="@r.ContactPhone" required />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label fw-semibold">Estimated Arrival Time</label>
                                                            <input type="datetime-local" name="EstimatedArrivalTime" class="form-control" value="@(r.EstimatedArrivalTime.HasValue ? r.EstimatedArrivalTime.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label fw-semibold">Issue Description</label>
                                                            <textarea name="IssueDescription" class="form-control" rows="2">@r.IssueDescription</textarea>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label fw-semibold">Patrol Technician Name</label>
                                                            <input type="text" name="AssignedTechnicianName" class="form-control" value="@r.AssignedTechnicianName" placeholder="e.g. Patrol Unit #4 - Rajesh" />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label fw-semibold">Patrol Contact Phone</label>
                                                            <input type="text" name="AssignedTechnicianPhone" class="form-control" value="@r.AssignedTechnicianPhone" placeholder="e.g. +91 98450 11223" />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label fw-semibold">Tow Truck Plate #</label>
                                                            <input type="text" name="TowTruckPlate" class="form-control" value="@r.TowTruckPlate" placeholder="e.g. KA05TR8899" />
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label fw-semibold">Resolution / Log Notes</label>
                                                            <textarea name="ResolutionNotes" class="form-control" rows="2" placeholder="e.g. Battery jumpstarted successfully. Vehicle operational.">@r.ResolutionNotes</textarea>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger fw-semibold">
                                                        <i class="bi bi-check-circle me-1"></i> Save & Update Details
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-check fs-1 text-success mb-2"></i>
                        <h5>No roadside emergencies reported</h5>
                        <p class="small">Our 24/7 rapid roadside network is on standby whenever you need emergency help.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>