@model IReadOnlyList<VehicleDto>
@{
    ViewData["Title"] = "My Garage";
    var activeJobs = ViewBag.ActiveJobs as List<AppointmentDto> ?? new List<AppointmentDto>();
    var recentAppts = ViewBag.RecentAppointments as List<AppointmentDto> ?? new List<AppointmentDto>();
}

<div class="container-fluid px-lg-4 my-4">
    <!-- Active Servicing Alert Bar -->
    @if (activeJobs.Any())
    {
        <div class="card bg-primary text-white p-3 mb-4 shadow border-0">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="spinner-grow text-light" role="status"></div>
                    <div>
                        <h5 class="fw-bold mb-0">Active Vehicle Service in Progress!</h5>
                        <p class="small mb-0 opacity-75">Your vehicle is currently undergoing service in our workshop.</p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    @foreach (var job in activeJobs)
                    {
                        <a asp-action="TrackJob" asp-route-id="@job.JobCardId" class="btn btn-light text-primary fw-semibold btn-sm shadow-sm">
                            <i class="bi bi-broadcast"></i> Track @job.RegistrationNumber &rarr;
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Garage Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Garage</h2>
            <p class="text-muted small mb-0">Manage registered vehicles, maintenance schedules, and warranties</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="AddVehicle" class="btn btn-outline-primary"><i class="bi bi-plus-circle"></i> Register New Vehicle</a>
            <a asp-action="BookService" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Book Service Appointment</a>
        </div>
    </div>

    <!-- Vehicles Cards Grid -->
    <div class="row g-4">
        @if (Model.Any())
        {
            @foreach (var v in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-dark font-monospace fs-6">@v.RegistrationNumber</span>
                                <h5 class="fw-bold mt-2 mb-0">@v.Make @v.Model</h5>
                                <span class="text-muted small">@v.Variant (@v.ManufacturingYear)</span>
                            </div>
                            <div class="stat-icon primary p-2 rounded-circle"><i class="bi bi-car-front-fill"></i></div>
                        </div>

                        <hr class="my-2 border-light">

                        <div class="row g-2 small text-muted my-1">
                            <div class="col-6"><i class="bi bi-speedometer"></i> <strong>@v.CurrentMileage.ToString("N0") KM</strong></div>
                            <div class="col-6"><i class="bi bi-fuel-pump"></i> @v.FuelType / @v.Transmission</div>
                            <div class="col-12"><i class="bi bi-shield-check text-success"></i> Ins: @(v.InsuranceProvider ?? "Active Policy")</div>
                        </div>

                        <!-- Maintenance Due Indicator -->
                        @if (v.IsMaintenanceDue)
                        {
                            <div class="alert alert-warning py-1 px-2 small mt-2 mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                <span><strong>Maintenance Due!</strong> Target: @v.NextServiceDueMileage.ToString("N0") KM</span>
                            </div>
                        }

                        <div class="d-flex gap-2 mt-3 pt-2 border-top">
                            <a asp-action="BookService" asp-route-vehicleId="@v.Id" class="btn btn-primary btn-sm flex-fill">
                                <i class="bi bi-calendar-check"></i> Book Service
                            </a>
                            <a asp-action="ServiceHistory" asp-route-vehicleId="@v.Id" class="btn btn-outline-secondary btn-sm" title="View Service History">
                                <i class="bi bi-clock-history"></i> History
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card p-5 text-center border-0 shadow-sm">
                    <i class="bi bi-car-front fs-1 text-muted mb-3"></i>
                    <h4>No vehicles registered yet</h4>
                    <p class="text-muted">Register your first vehicle to schedule periodic servicing and track repairs.</p>
                    <a asp-action="AddVehicle" class="btn btn-primary mx-auto">Register Vehicle Now</a>
                </div>
            </div>
        }
    </div>
</div>