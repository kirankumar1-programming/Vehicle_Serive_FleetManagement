@model JobCardDto
@{
    ViewData["Title"] = "Review Vehicle Service";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card p-4 shadow border-0">
                <div class="text-center mb-4">
                    <i class="bi bi-star-fill fs-1 text-warning"></i>
                    <h3 class="fw-bold mt-2">Rate Your Service Experience</h3>
                    <p class="text-muted small">Job Card: @Model.JobCardNumber | @Model.VehicleInfo</p>
                </div>

                <form asp-action="SubmitReview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobCardId" value="@Model.Id" />

                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold d-block">Overall Experience</label>
                        <select name="overallRating" class="form-select form-select-lg mx-auto text-center" style="max-width: 250px;">
                            <option value="5" selected>⭐⭐⭐⭐⭐ 5 - Excellent</option>
                            <option value="4">⭐⭐⭐⭐ 4 - Very Good</option>
                            <option value="3">⭐⭐⭐ 3 - Average</option>
                            <option value="2">⭐⭐ 2 - Poor</option>
                            <option value="1">⭐ 1 - Very Poor</option>
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4 text-center">
                            <label class="form-label small fw-semibold">Service Quality</label>
                            <select name="qualityScore" class="form-select">
                                <option value="5" selected>5/5 - Perfect</option>
                                <option value="4">4/5 - Good</option>
                                <option value="3">3/5 - Okay</option>
                            </select>
                        </div>
                        <div class="col-md-4 text-center">
                            <label class="form-label small fw-semibold">Staff & Advisor</label>
                            <select name="staffRating" class="form-select">
                                <option value="5" selected>5/5 - Courteous</option>
                                <option value="4">4/5 - Helpful</option>
                                <option value="3">3/5 - Average</option>
                            </select>
                        </div>
                        <div class="col-md-4 text-center">
                            <label class="form-label small fw-semibold">Cleanliness</label>
                            <select name="cleanRating" class="form-select">
                                <option value="5" selected>5/5 - Spotless</option>
                                <option value="4">4/5 - Clean</option>
                                <option value="3">3/5 - Acceptable</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comments & Feedback</label>
                        <textarea name="comments" class="form-control" rows="3" placeholder="Tell us about the vehicle driving performance and workshop experience..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold">Submit Review</button>
                </form>
            </div>
        </div>
    </div>
</div>