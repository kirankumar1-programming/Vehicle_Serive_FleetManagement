@model BookAppointmentDto
@{
    ViewData["Title"] = "Schedule Service Appointment";
    var vehicles = ViewBag.Vehicles as IReadOnlyList<VehicleDto> ?? new List<VehicleDto>();
    var serviceTypes = ViewBag.ServiceTypes as IReadOnlyList<ServiceType> ?? new List<ServiceType>();
    var servicePackages = ViewBag.ServicePackages as IReadOnlyList<ServicePackage> ?? new List<ServicePackage>();
    var serviceCenters = ViewBag.ServiceCenters as IReadOnlyList<ServiceCenter> ?? new List<ServiceCenter>();
    var selectedVehicle = ViewBag.SelectedVehicle as VehicleDto ?? vehicles.FirstOrDefault(v => v.Id == Model.VehicleId) ?? vehicles.FirstOrDefault();
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card p-4 shadow border-0">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="stat-icon primary"><i class="bi bi-calendar-plus-fill"></i></div>
                    <div>
                        <h3 class="fw-bold mb-0">Schedule Service Appointment</h3>
                        <p class="text-muted small mb-0">Book guaranteed service slots with instant confirmation</p>
                    </div>
                </div>

                <form asp-action="BookService" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Step 1: Select Vehicle -->
                    <div class="mb-4">
                        <h5 class="form-step-header mb-3"><i class="bi bi-1-circle-fill"></i> Select Vehicle</h5>
                        @if (vehicles.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary">Choose Vehicle from Fleet / Registered Vehicles</label>
                                <select asp-for="VehicleId" id="vehicleSelect" class="form-select form-select-lg" required>
                                    @foreach (var v in vehicles)
                                    {
                                        <option value="@v.Id" 
                                                selected="@(v.Id == Model.VehicleId)"
                                                data-make="@v.Make" 
                                                data-model="@v.Model" 
                                                data-variant="@v.Variant" 
                                                data-reg="@v.RegistrationNumber" 
                                                data-year="@v.ManufacturingYear" 
                                                data-color="@v.Color" 
                                                data-fuel="@v.FuelType" 
                                                data-trans="@v.Transmission" 
                                                data-mileage="@v.CurrentMileage.ToString("N0")"
                                                data-lastservice="@(v.LastServiceDate?.ToString("yyyy-MM-dd") ?? "Initial Factory")"
                                                data-targetdue="@v.NextServiceDueMileage.ToString("N0")"
                                                data-maintdue="@(v.IsMaintenanceDue ? "true" : "false")"
                                                data-fleet="@v.CompanyFleetName"
                                                data-owner="@v.CustomerName">
                                            @v.Make @v.Model (@v.RegistrationNumber) — @v.CurrentMileage.ToString("N0") KM @(v.IsMaintenanceDue ? "⚠️ [Maintenance Due]" : "")
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Selected Vehicle Details Card -->
                            <div id="vehicleDetailsCard" class="card border border-primary bg-light-subtle p-3 rounded-3 shadow-sm">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h5 class="fw-bold mb-1 text-primary d-flex align-items-center gap-2">
                                            <i class="bi bi-car-front-fill"></i>
                                            <span id="detailMakeModel">@(selectedVehicle != null ? $"{selectedVehicle.Make} {selectedVehicle.Model} {selectedVehicle.Variant}" : "")</span>
                                        </h5>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="badge bg-dark font-monospace fs-6" id="detailReg">@(selectedVehicle?.RegistrationNumber)</span>
                                            <span class="badge bg-secondary" id="detailFuelTrans">@(selectedVehicle != null ? $"{selectedVehicle.FuelType} • {selectedVehicle.Transmission}" : "")</span>
                                            <span class="badge bg-info text-dark" id="detailYearColor">@(selectedVehicle != null ? $"{selectedVehicle.ManufacturingYear} • {selectedVehicle.Color}" : "")</span>
                                        </div>
                                    </div>
                                    <div id="detailMaintenanceAlert" style="display: @(selectedVehicle?.IsMaintenanceDue == true ? "block" : "none");">
                                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Preventive Maintenance Due
                                        </span>
                                    </div>
                                </div>
                                <div class="row g-2 pt-2 border-top text-muted small">
                                    <div class="col-6 col-md-3">
                                        <span class="text-secondary d-block">Current Odometer:</span>
                                        <strong class="text-dark fs-6" id="detailMileage">@(selectedVehicle != null ? selectedVehicle.CurrentMileage.ToString("N0") + " KM" : "")</strong>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <span class="text-secondary d-block">Next Service Due:</span>
                                        <strong class="text-dark" id="detailTargetDue">@(selectedVehicle != null ? selectedVehicle.NextServiceDueMileage.ToString("N0") + " KM" : "N/A")</strong>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <span class="text-secondary d-block">Last Serviced:</span>
                                        <span class="text-dark" id="detailLastService">@(selectedVehicle?.LastServiceDate?.ToString("yyyy-MM-dd") ?? "Initial Factory")</span>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <span class="text-secondary d-block">Assigned To:</span>
                                        <span class="text-dark fw-semibold" id="detailOwnerFleet">@(selectedVehicle?.CompanyFleetName ?? selectedVehicle?.CustomerName ?? "Personal Vehicle")</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                You have no registered vehicles. <a asp-action="AddVehicle" class="fw-bold">Register a vehicle first &rarr;</a>
                            </div>
                        }
                    </div>

                    <!-- Step 2: Select Service or Package -->
                    <div class="mb-4">
                        <h5 class="form-step-header mb-3"><i class="bi bi-2-circle-fill"></i> Select Service or Package</h5>
                        <ul class="nav nav-pills mb-3" id="serviceTab" role="tablist">
                            <li class="nav-item"><button class="nav-link active" id="single-tab" data-bs-toggle="pill" data-bs-target="#single" type="button">Individual Services</button></li>
                            <li class="nav-item"><button class="nav-link" id="package-tab" data-bs-toggle="pill" data-bs-target="#package" type="button">Curated Packages (Save 20%+)</button></li>
                        </ul>
                        <div class="tab-content" id="serviceTabContent">
                            <div class="tab-pane fade show active" id="single">
                                <div class="row g-3">
                                    @foreach (var s in serviceTypes)
                                    {
                                        <div class="col-md-6">
                                            <label class="card p-3 border h-100">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <input type="radio" asp-for="ServiceTypeId" value="@s.Id" class="form-check-input" />
                                                    <span class="badge bg-primary fs-6">₹@s.BasePrice.ToString("N0")</span>
                                                </div>
                                                <strong class="d-block">@s.Name</strong>
                                                <p class="text-muted small mb-0">@s.Description</p>
                                                <div class="small text-secondary mt-2"><i class="bi bi-clock"></i> ~@s.EstimatedDurationHours hrs | Labor: ₹@s.LaborCharges.ToString("N0")</div>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="tab-pane fade" id="package">
                                <div class="row g-3">
                                    @foreach (var pkg in servicePackages)
                                    {
                                        <div class="col-md-6">
                                            <label class="card p-3 border h-100 border-primary">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <input type="radio" asp-for="ServicePackageId" value="@pkg.Id" class="form-check-input" />
                                                    <span class="badge bg-success">Save @pkg.SavingsPercent%</span>
                                                </div>
                                                <strong class="text-primary d-block">@pkg.Name</strong>
                                                <p class="text-muted small mb-1">@pkg.Description</p>
                                                <div class="fw-bold fs-5 text-dark">₹@pkg.PackagePrice.ToString("N0")</div>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Select Service Center, Date & Time Slot -->
                    <div class="mb-4">
                        <h5 class="form-step-header mb-3"><i class="bi bi-3-circle-fill"></i> Center, Date & Time Slot</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Service Center</label>
                                <select asp-for="ServiceCenterId" class="form-select" required>
                                    @foreach (var c in serviceCenters)
                                    {
                                        <option value="@c.Id">@c.Name (@c.City)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Appointment Date</label>
                                <input asp-for="AppointmentDate" type="date" class="form-control" value="@DateTime.UtcNow.Date.AddDays(1).ToString("yyyy-MM-dd")" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Preferred Time Slot</label>
                                <select asp-for="TimeSlot" class="form-select" required>
                                    <option value="08:30 AM - 10:30 AM">08:30 AM - 10:30 AM</option>
                                    <option value="09:00 AM - 11:00 AM" selected>09:00 AM - 11:00 AM</option>
                                    <option value="11:30 AM - 01:30 PM">11:30 AM - 01:30 PM</option>
                                    <option value="02:00 PM - 04:00 PM">02:00 PM - 04:00 PM</option>
                                    <option value="04:30 PM - 06:30 PM">04:30 PM - 06:30 PM</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: Doorstep Pickup & Observations -->
                    <div class="mb-4">
                        <h5 class="form-step-header mb-3"><i class="bi bi-4-circle-fill"></i> Additional Details</h5>
                        <div class="mb-3 form-check">
                            <input asp-for="RequiresPickupDrop" class="form-check-input" id="chkPickup" onchange="document.getElementById('pickupBox').style.display = this.checked ? 'block' : 'none';" />
                            <label class="form-check-label fw-semibold" for="chkPickup">Request Valet Doorstep Vehicle Pick-up & Drop-off</label>
                        </div>
                        <div class="mb-3" id="pickupBox" style="display: none;">
                            <label class="form-label fw-semibold">Pickup Address</label>
                            <textarea asp-for="PickupAddress" class="form-control" rows="2" placeholder="Full residential/office address for vehicle pickup"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Specific Issues or Symptoms Noticed (Optional)</label>
                            <textarea asp-for="CustomerNotes" class="form-control" rows="2" placeholder="e.g. Brake noise, AC cooling weak, engine vibration at idle..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold">
                            <i class="bi bi-check-lg"></i> Confirm & Book Appointment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vehicleSelect = document.getElementById('vehicleSelect');
            if (!vehicleSelect) return;

            function updateVehicleDetails() {
                const selectedOpt = vehicleSelect.options[vehicleSelect.selectedIndex];
                if (!selectedOpt) return;

                const make = selectedOpt.getAttribute('data-make') || '';
                const model = selectedOpt.getAttribute('data-model') || '';
                const variant = selectedOpt.getAttribute('data-variant') || '';
                const reg = selectedOpt.getAttribute('data-reg') || '';
                const year = selectedOpt.getAttribute('data-year') || '';
                const color = selectedOpt.getAttribute('data-color') || '';
                const fuel = selectedOpt.getAttribute('data-fuel') || '';
                const trans = selectedOpt.getAttribute('data-trans') || '';
                const mileage = selectedOpt.getAttribute('data-mileage') || '';
                const lastService = selectedOpt.getAttribute('data-lastservice') || 'Initial Factory';
                const targetDue = selectedOpt.getAttribute('data-targetdue') || 'N/A';
                const isMaintDue = selectedOpt.getAttribute('data-maintdue') === 'true';
                const fleet = selectedOpt.getAttribute('data-fleet') || '';
                const owner = selectedOpt.getAttribute('data-owner') || '';

                const makeModelEl = document.getElementById('detailMakeModel');
                if (makeModelEl) makeModelEl.textContent = `${make} ${model} ${variant}`.trim();

                const regEl = document.getElementById('detailReg');
                if (regEl) regEl.textContent = reg;

                const fuelTransEl = document.getElementById('detailFuelTrans');
                if (fuelTransEl) fuelTransEl.textContent = `${fuel} • ${trans}`;

                const yearColorEl = document.getElementById('detailYearColor');
                if (yearColorEl) yearColorEl.textContent = `${year} • ${color}`;

                const mileageEl = document.getElementById('detailMileage');
                if (mileageEl) mileageEl.textContent = mileage ? `${mileage} KM` : 'N/A';

                const targetDueEl = document.getElementById('detailTargetDue');
                if (targetDueEl) targetDueEl.textContent = targetDue ? `${targetDue} KM` : 'N/A';

                const lastServiceEl = document.getElementById('detailLastService');
                if (lastServiceEl) lastServiceEl.textContent = lastService;

                const ownerFleetEl = document.getElementById('detailOwnerFleet');
                if (ownerFleetEl) ownerFleetEl.textContent = fleet || owner || 'Personal Vehicle';

                const alertEl = document.getElementById('detailMaintenanceAlert');
                if (alertEl) {
                    alertEl.style.display = isMaintDue ? 'block' : 'none';
                }
            }

            vehicleSelect.addEventListener('change', updateVehicleDetails);
            updateVehicleDetails();
        });
    </script>
}