@model CreateVehicleDto
@{
    ViewData["Title"] = "Add Fleet Vehicle";
    var fleet = ViewBag.Fleet as CompanyFleet;
    int fleetId = ViewBag.FleetId ?? 0;
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4 shadow border-0">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon primary"><i class="bi bi-truck text-danger"></i></div>
                        <div>
                            <h3 class="fw-bold mb-0">Register Fleet Vehicle</h3>
                            <p class="text-muted small mb-0">Add a new commercial vehicle to the corporate fleet inventory</p>
                        </div>
                    </div>
                    @if (fleet != null)
                    {
                        <span class="badge bg-primary fs-6"><i class="bi bi-building me-1"></i> @fleet.CompanyName</span>
                    }
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form asp-action="AddVehicle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CompanyFleetId" value="@fleetId" />

                    <!-- Status Banner / Toggle -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="bi bi-power text-primary me-1"></i> Initial Operational Status</h6>
                                <p class="text-muted small mb-0">
                                    Active commercial vehicles can immediately be assigned to drivers and scheduled for operations.
                                </p>
                            </div>
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsActive" class="form-check-input cursor-pointer" type="checkbox" role="switch" id="isActiveSwitch" checked />
                                <label class="form-check-label fs-6 fw-semibold ms-1" for="isActiveSwitch">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Vehicle Identifiers -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Registration / License Plate Number *</label>
                            <input asp-for="RegistrationNumber" class="form-control text-uppercase font-monospace" placeholder="e.g. KA01MJ4589" required />
                            <small class="text-muted">Unique commercial license plate number.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vehicle Identification Number (VIN) *</label>
                            <input asp-for="VIN" class="form-control text-uppercase font-monospace" placeholder="17-digit Chassis / VIN" maxlength="17" required />
                            <small class="text-muted">17-character unique chassis identification number.</small>
                        </div>

                        <!-- Core Specifications -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Make / Manufacturer *</label>
                            <input asp-for="Make" class="form-control" placeholder="e.g. Tata, Mahindra, Ashok Leyland" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Model *</label>
                            <input asp-for="Model" class="form-control" placeholder="e.g. Ace Gold, Bolero Maxi, Dost" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Variant / Trim</label>
                            <input asp-for="Variant" class="form-control" placeholder="e.g. Plus, High Deck, CNG" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Manufacturing Year</label>
                            <input asp-for="ManufacturingYear" type="number" class="form-control" min="1990" max="@(DateTime.UtcNow.Year + 1)" value="@(DateTime.UtcNow.Year)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Color</label>
                            <input asp-for="Color" class="form-control" placeholder="e.g. White, Silver, Yellow" value="White" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Starting Odometer (KM) *</label>
                            <input asp-for="CurrentMileage" type="number" class="form-control" min="0" value="0" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Fuel Type</label>
                            <select asp-for="FuelType" class="form-select" asp-items="Html.GetEnumSelectList<VehicleFuelType>()"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Transmission</label>
                            <select asp-for="Transmission" class="form-select" asp-items="Html.GetEnumSelectList<TransmissionType>()"></select>
                        </div>

                        <!-- Commercial Insurance Details -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Insurance Provider</label>
                            <input asp-for="InsuranceProvider" class="form-control" placeholder="e.g. Tata AIG, HDFC ERGO" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Policy Number</label>
                            <input asp-for="InsurancePolicyNumber" class="form-control" placeholder="POL-FLT-123456" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Insurance Expiry Date</label>
                            <input asp-for="InsuranceExpiryDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Vehicles" asp-route-fleetId="@fleetId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel & Return
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-plus-circle me-1"></i> Register Fleet Vehicle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const switchEl = document.getElementById('isActiveSwitch');
        if (switchEl) {
            switchEl.addEventListener('change', function () {
                const label = this.nextElementSibling;
                if (label) {
                    label.textContent = this.checked ? 'Active' : 'Inactive';
                }
            });
        }
    });
</script>
