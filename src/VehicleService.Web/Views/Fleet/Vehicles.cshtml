@model IReadOnlyList<VehicleDto>
@{
    ViewData["Title"] = "Fleet Vehicles & Drivers";
    var drivers = ViewBag.Drivers as IList<ApplicationUser> ?? new List<ApplicationUser>();
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-truck text-danger"></i> Fleet Vehicles & Driver Assignments</h2>
            <p class="text-muted small mb-0">Assign commercial drivers to vehicles and track odometer readings</p>
        </div>
        <div>
            <a asp-action="AddVehicle" asp-route-fleetId="@ViewBag.TargetFleetId" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Add Fleet Vehicle
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Registration Plate</th>
                        <th>VIN</th>
                        <th>Make & Model</th>
                        <th>Odometer (KM)</th>
                        <th>Assigned Driver</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted mb-3"><i class="bi bi-truck fs-1 text-secondary"></i></div>
                                <h5 class="fw-bold text-dark">No commercial vehicles registered in this fleet</h5>
                                <p class="text-muted small mb-3">Add your first commercial vehicle to track odometer, assign drivers, and manage services.</p>
                                <a asp-action="AddVehicle" asp-route-fleetId="@ViewBag.TargetFleetId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-plus-circle me-1"></i> Add Fleet Vehicle
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var v in Model)
                        {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@v.RegistrationNumber</td>
                            <td class="font-monospace small">@v.VIN</td>
                            <td><strong>@v.Make @v.Model</strong> (@v.FuelType)</td>
                            <td class="fw-bold">@v.CurrentMileage.ToString("N0") KM</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person"></i> @(v.CurrentDriverName ?? "No Driver Assigned")
                                </span>
                            </td>
                            <td>
                                @if (v.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        <i class="bi bi-slash-circle me-1"></i> Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="EditVehicle" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary" title="Edit Vehicle Details">
                                        <i class="bi bi-pencil-square"></i> Edit Details
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#driverModal_@v.Id">
                                        <i class="bi bi-person-plus"></i> Assign Driver
                                    </button>
                                </div>

                                <!-- Driver Modal -->
                                <div class="modal fade" id="driverModal_@v.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold">Assign Driver to @v.RegistrationNumber</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="AssignDriver" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="VehicleId" value="@v.Id" />
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Select Driver</label>
                                                        <select name="DriverId" class="form-select" required>
                                                            @foreach (var d in drivers)
                                                            {
                                                                <option value="@d.Id">@d.FullName (@d.PhoneNumber)</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Driver License Number</label>
                                                        <input type="text" name="LicenseNumber" class="form-control" placeholder="DL-KA-2022-998877" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Save Assignment</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>