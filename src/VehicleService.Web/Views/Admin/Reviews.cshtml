@model IReadOnlyList<CustomerReviewDto>
@{
    ViewData["Title"] = "Customer Reviews Moderation";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-star-half text-warning"></i> Customer Reviews & Moderation</h2>
            <p class="text-muted small mb-0">Review ratings, service quality scores, and publish customer feedback</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var r in Model)
        {
            <div class="col-md-6">
                <div class="card p-4 border-0 shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-0">@r.CustomerName</h5>
                            <small class="text-muted">Job Card: @r.JobCardNumber | @r.CreatedAt.ToString("yyyy-MM-dd")</small>
                        </div>
                        <div>
                            @for (int i = 1; i <= r.OverallRating; i++)
                            {
                                <i class="bi bi-star-fill text-warning"></i>
                            }
                        </div>
                    </div>
                    <p class="text-secondary small my-2">"@r.Comments"</p>
                    <div class="d-flex gap-2 pt-2 border-top mt-auto">
                        <span class="badge @(r.Status == ReviewStatus.Approved ? "bg-success" : "bg-warning text-dark")">@r.Status</span>
                        @if (r.Status != ReviewStatus.Approved)
                        {
                            <form asp-action="ModerateReview" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reviewId" value="@r.Id" />
                                <input type="hidden" name="status" value="@ReviewStatus.Approved" />
                                <button type="submit" class="btn btn-sm btn-success">Approve & Publish</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>