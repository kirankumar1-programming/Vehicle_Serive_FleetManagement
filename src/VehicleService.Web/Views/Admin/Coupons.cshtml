@model IReadOnlyList<Coupon>
@{
    ViewData["Title"] = "Coupons & Discounts";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-tag-fill text-primary"></i> Promotional Coupons & Discount Rules</h2>
            <p class="text-muted small mb-0">Active coupon codes, corporate discounts, and seasonal promotions</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card p-4 border-0 shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary fs-6 font-monospace">@c.Code</span>
                        <span class="badge bg-success">Active</span>
                    </div>
                    <h5 class="fw-bold mt-2 mb-1">@c.Title</h5>
                    <div class="small text-muted mb-2">
                        Discount: <strong>@(c.Type == DiscountType.Percentage ? $"{c.Value}%" : $"₹{c.Value:N0}")</strong>
                    </div>
                    <div class="small text-secondary">
                        <div>Min Bill: ₹@c.MinimumBillAmount.ToString("N0")</div>
                        <div>Max Cap: ₹@c.MaxDiscountLimit.ToString("N0")</div>
                        <div>Expires: @c.ExpiryDate.ToString("yyyy-MM-dd")</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>