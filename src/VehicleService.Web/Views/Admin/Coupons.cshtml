@model IReadOnlyList<Coupon>
@{
    ViewData["Title"] = "Coupons & Discounts";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-tag-fill text-primary"></i> Promotional Coupons & Discount Rules</h2>
            <p class="text-muted small mb-0">Create, manage, and configure campaign discount codes, limits, validity, and active statuses</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border font-monospace px-3 py-2">
                Total Coupons: @Model.Count
            </span>
            <a asp-action="AddCoupon" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> Add New Coupon
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center border-0 shadow-sm">
            <div class="mb-3">
                <i class="bi bi-tag fs-1 text-muted"></i>
            </div>
            <h4>No Promotional Coupons Created Yet</h4>
            <p class="text-muted">Start creating discount coupons to boost customer engagement and corporate bookings.</p>
            <div class="mt-2">
                <a asp-action="AddCoupon" class="btn btn-primary">
                    <i class="bi bi-plus-circle-fill me-1"></i> Create First Coupon
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model)
            {
                var isExpired = c.ExpiryDate < DateTime.UtcNow;
                <div class="col-md-6 col-lg-4">
                    <div class="card p-4 border-0 shadow-sm h-100 position-relative @(!c.IsActive ? "opacity-75 bg-light" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary fs-6 font-monospace px-2 py-1">@c.Code</span>
                                <span class="badge bg-light text-dark border small">@c.Type</span>
                            </div>
                            <div>
                                @if (isExpired)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-clock-history me-1"></i> Expired
                                    </span>
                                }
                                else if (c.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                        <i class="bi bi-pause-circle me-1"></i> Inactive
                                    </span>
                                }
                            </div>
                        </div>

                        <h5 class="fw-bold mt-2 mb-1 text-dark">@c.Title</h5>

                        <div class="my-2 p-2 rounded bg-light border-start border-4 border-primary">
                            <div class="small text-muted">Discount Value:</div>
                            <div class="fs-4 fw-bold text-primary">
                                @(c.Type == DiscountType.Percentage ? $"{c.Value:0.#}% OFF" : $"₹{c.Value:N0} FLAT OFF")
                            </div>
                        </div>

                        <div class="small text-secondary my-2">
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span>Min Bill Required:</span>
                                <strong class="text-dark">₹@c.MinimumBillAmount.ToString("N0")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span>Max Discount Cap:</span>
                                <strong class="text-dark">₹@c.MaxDiscountLimit.ToString("N0")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span>Usage Quota:</span>
                                <span class="badge bg-light text-dark border font-monospace">@c.TimesUsed / @c.UsageLimit</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span>Expires On:</span>
                                <strong class="@(isExpired ? "text-danger" : "text-dark")">@c.ExpiryDate.ToString("yyyy-MM-dd")</strong>
                            </div>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex gap-2">
                            <a asp-action="EditCoupon" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm flex-fill fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i> Edit Details
                            </a>
                            <form asp-action="ToggleCouponStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="@(c.IsActive ? "Deactivate Coupon" : "Activate Coupon")">
                                    <i class="bi @(c.IsActive ? "bi-pause-fill text-warning" : "bi-play-fill text-success")"></i>
                                    @(c.IsActive ? "Pause" : "Resume")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>