@model IReadOnlyList<AuditLogDto>
@{
    ViewData["Title"] = "System Audit Logs";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-fingerprint text-primary"></i> System Audit Trail</h2>
            <p class="text-muted small mb-0">Chronological security and operational audit trail of system modifications</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Entity ID</th>
                        <th>Values Changed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="font-monospace small">@l.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><strong>@(l.UserName ?? l.UserId ?? "System")</strong></td>
                            <td><span class="badge bg-secondary">@l.Action</span></td>
                            <td>@l.EntityName</td>
                            <td class="font-monospace small">@l.EntityId</td>
                            <td class="small text-muted">@l.NewValues</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>