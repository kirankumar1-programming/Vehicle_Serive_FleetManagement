@model UpdateServiceBayDto
@{
    ViewData["Title"] = $"Edit Bay - {Model.BayName}";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card p-4 shadow border-0">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon primary p-3 rounded-circle bg-primary-subtle text-primary">
                            <i class="bi bi-tools fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">Edit Service Bay</h3>
                            <p class="text-muted small mb-0">Update bay name, number, equipment type, status, and availability</p>
                        </div>
                    </div>
                    <span class="badge bg-secondary font-monospace fs-6">@Model.BayNumber</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.ServiceCenterName))
                {
                    <div class="alert alert-light border d-flex align-items-center gap-2 py-2 mb-3">
                        <i class="bi bi-geo-alt-fill text-primary"></i>
                        <span>Located at: <strong>@Model.ServiceCenterName</strong></span>
                    </div>
                }

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form asp-action="EditServiceBay" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ServiceCenterId" />

                    <!-- Status Banner / Toggle -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="bi bi-power text-primary me-1"></i> Bay Operational Status</h6>
                                <p class="text-muted small mb-0">
                                    Active bays can be assigned to job cards and scheduled for appointments.
                                </p>
                            </div>
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsActive" class="form-check-input cursor-pointer" type="checkbox" role="switch" id="bayIsActiveSwitch" />
                                <label class="form-check-label fs-6 fw-semibold ms-1" for="bayIsActiveSwitch">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bay Number / Code *</label>
                            <input asp-for="BayNumber" class="form-control font-monospace" placeholder="e.g. BAY-101" required />
                            <span asp-validation-for="BayNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bay Name *</label>
                            <input asp-for="BayName" class="form-control" placeholder="e.g. Service Bay #1 (General)" required />
                            <span asp-validation-for="BayName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bay Type / Specialization</label>
                            <input asp-for="BayType" class="form-control" list="bayTypeOptions" placeholder="e.g. General, Express, Wheel Alignment" />
                            <datalist id="bayTypeOptions">
                                <option value="General Maintenance" />
                                <option value="Express Service" />
                                <option value="Wheel Alignment & Balancing" />
                                <option value="Heavy Repair & Transmission" />
                                <option value="Painting & Denting" />
                                <option value="OBD Diagnostics & Electrical" />
                                <option value="Washing & Detailing" />
                            </datalist>
                            <span asp-validation-for="BayType" class="text-danger small"></span>
                            <small class="text-muted">Select from suggestions or type a custom bay type.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Current Occupancy / Status *</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BayStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                            <small class="text-muted">Available, Occupied by vehicle, or Under Maintenance.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="ServiceCenters" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Service Centers
                        </a>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle"></i> Save Bay Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const switchEl = document.getElementById('bayIsActiveSwitch');
            if (switchEl) {
                switchEl.addEventListener('change', function () {
                    const label = this.nextElementSibling;
                    if (label) {
                        label.textContent = this.checked ? 'Active' : 'Inactive';
                    }
                });
            }
        });
    </script>
}
