@model IReadOnlyList<ApplicationUser>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary"></i> User & RBAC Role Management</h2>
            <p class="text-muted small mb-0">Manage platform users, roles, permissions, and service center assignments</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email / Username</th>
                        <th>Phone</th>
                        <th>Role Type</th>
                        <th>Status</th>
                        <th>Registered Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td><strong>@u.FullName</strong></td>
                            <td>@u.Email</td>
                            <td>@u.PhoneNumber</td>
                            <td><span class="badge bg-dark font-monospace">@u.RoleType</span></td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td>@u.CreatedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>