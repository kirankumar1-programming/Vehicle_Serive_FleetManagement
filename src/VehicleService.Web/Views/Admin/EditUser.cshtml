@model UpdateUserDetailsDto
@{
    ViewData["Title"] = $"Edit User - {Model.FullName}";
    var serviceCenters = ViewBag.ServiceCenters as IReadOnlyList<ServiceCenter> ?? new List<ServiceCenter>();
    var companyFleets = ViewBag.CompanyFleets as IReadOnlyList<CompanyFleet> ?? new List<CompanyFleet>();
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4 shadow border-0">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon primary p-3 rounded-circle bg-primary-subtle text-primary">
                            <i class="bi bi-person-gear fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">Edit User Details</h3>
                            <p class="text-muted small mb-0">Manage profile information, role-based access, and facility/fleet assignments</p>
                        </div>
                    </div>
                    <span class="badge bg-primary font-monospace fs-6">@Model.Email</span>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form asp-action="EditUser" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <!-- Status Banner / Toggle -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="bi bi-shield-check text-primary me-1"></i> User Account Status</h6>
                                <p class="text-muted small mb-0">
                                    Active users can authenticate, access their respective portals, and perform assigned operational duties.
                                </p>
                            </div>
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsActive" class="form-check-input cursor-pointer" type="checkbox" role="switch" id="userIsActiveSwitch" />
                                <label class="form-check-label fs-6 fw-semibold ms-1" for="userIsActiveSwitch">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Personal & Contact Info -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="e.g. Vikram Malhotra" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email / Username *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="advisor@vehicleservice.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+91 99001 00002" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">RBAC System Role *</label>
                            <select asp-for="RoleType" class="form-select" asp-items="Html.GetEnumSelectList<UserRoleType>()"></select>
                            <span asp-validation-for="RoleType" class="text-danger small"></span>
                            <small class="text-muted">Defines portal access and operational permissions.</small>
                        </div>

                        <!-- Organizational Linkage -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assigned Service Center</label>
                            <select asp-for="ServiceCenterId" class="form-select">
                                <option value="">-- None / Head Office --</option>
                                @foreach (var c in serviceCenters)
                                {
                                    <option value="@c.Id">@c.Name (@c.Code)</option>
                                }
                            </select>
                            <small class="text-muted">Applicable for Service Advisors, Mechanics, and Inventory Managers.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assigned Corporate Fleet</label>
                            <select asp-for="CompanyFleetId" class="form-select">
                                <option value="">-- None / Retail Customer --</option>
                                @foreach (var f in companyFleets)
                                {
                                    <option value="@f.Id">@f.CompanyName</option>
                                }
                            </select>
                            <small class="text-muted">Applicable for Corporate Fleet Managers and Fleet Drivers.</small>
                        </div>

                        <!-- Address Details -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Street Address</label>
                            <input asp-for="Address" class="form-control" placeholder="e.g. 123 MG Road, Suite 400" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">City</label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Bangalore" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">State / Region</label>
                            <input asp-for="State" class="form-control" placeholder="e.g. Karnataka" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control" placeholder="e.g. 560001" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Users" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to User List
                        </a>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle"></i> Save User Details
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const switchEl = document.getElementById('userIsActiveSwitch');
            if (switchEl) {
                switchEl.addEventListener('change', function () {
                    const label = this.nextElementSibling;
                    if (label) {
                        label.textContent = this.checked ? 'Active' : 'Inactive';
                    }
                });
            }
        });
    </script>
}
