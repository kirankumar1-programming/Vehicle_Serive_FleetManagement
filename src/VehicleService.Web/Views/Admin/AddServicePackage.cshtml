@model CreateServicePackageDto
@{
    ViewData["Title"] = "Add Bundled Service Package";
    var serviceTypes = ViewBag.ServiceTypes as List<ServiceType> ?? new List<ServiceType>();
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card p-4 shadow border-0">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon primary p-3 rounded-circle bg-primary-subtle text-primary">
                            <i class="bi bi-box2-heart fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">Create Bundled Service Package</h3>
                            <p class="text-muted small mb-0">Combine multiple individual services into a discounted periodic maintenance bundle</p>
                        </div>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form asp-action="AddServicePackage" method="post" id="packageForm">
                    @Html.AntiForgeryToken()

                    <!-- Status Banner / Toggle -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="bi bi-power text-primary me-1"></i> Package Availability Status</h6>
                                <p class="text-muted small mb-0">
                                    Active packages can be selected by customers on the homepage and booking portal.
                                </p>
                            </div>
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsActive" class="form-check-input cursor-pointer" type="checkbox" role="switch" id="pkgIsActiveSwitch" checked />
                                <label class="form-check-label fs-6 fw-semibold ms-1" for="pkgIsActiveSwitch">
                                    Active
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Package Name -->
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Package Name *</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Comprehensive Monsoon Readiness Package" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <!-- Validity -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Package Validity (Days) *</label>
                            <div class="input-group">
                                <input asp-for="ValidityDays" class="form-control" type="number" min="1" max="3650" required />
                                <span class="input-group-text">days</span>
                            </div>
                            <span asp-validation-for="ValidityDays" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Package Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the inclusions, targeted inspection areas, and customer benefits of this bundle..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Bundled Services Checklist -->
                        <div class="col-12 mt-4">
                            <div class="card border">
                                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold"><i class="bi bi-check2-square text-primary me-1"></i> Select Services to Bundle *</span>
                                    <span class="badge bg-primary" id="selectedCountBadge">0 services selected</span>
                                </div>
                                <div class="card-body p-0" style="max-height: 280px; overflow-y: auto;">
                                    @if (!serviceTypes.Any())
                                    {
                                        <div class="p-3 text-muted small text-center">No active service catalog items available to bundle.</div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach (var s in serviceTypes)
                                            {
                                                var totalServiceCost = s.BasePrice + s.LaborCharges;
                                                var isChecked = Model.SelectedServiceTypeIds != null && Model.SelectedServiceTypeIds.Contains(s.Id);
                                                <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 cursor-pointer py-2 px-3">
                                                    <input class="form-check-input flex-shrink-0 service-checkbox" type="checkbox" name="SelectedServiceTypeIds" value="@s.Id" data-price="@totalServiceCost" @(isChecked ? "checked" : "") />
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex justify-content-between">
                                                            <strong class="text-dark">@s.Name</strong>
                                                            <span class="text-primary fw-semibold font-monospace">₹@totalServiceCost.ToString("N0")</span>
                                                        </div>
                                                        <small class="text-muted">
                                                            Code: <span class="font-monospace">@s.Code</span> | Category: <span class="badge bg-secondary-subtle text-secondary border">@s.Category</span> | Base: ₹@s.BasePrice.ToString("N0") + Labor: ₹@s.LaborCharges.ToString("N0")
                                                        </small>
                                                    </div>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <span asp-validation-for="SelectedServiceTypeIds" class="text-danger small"></span>
                        </div>

                        <!-- Pricing & Savings Calculation Card -->
                        <div class="col-12 mt-3">
                            <div class="card bg-light border-0 p-3">
                                <h6 class="fw-bold mb-3"><i class="bi bi-calculator text-primary me-1"></i> Pricing & Savings Calculation</h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Combined Original Price (₹)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="OriginalTotalPrice" class="form-control fw-bold" id="originalPriceInput" type="number" step="1" min="0" placeholder="Auto-calculated" />
                                        </div>
                                        <div class="form-text small">Sum of selected services' base + labor.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Discounted Package Price (₹) *</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input asp-for="PackagePrice" class="form-control fw-bold text-primary" id="packagePriceInput" type="number" step="1" min="0.01" placeholder="e.g. 3999" required />
                                        </div>
                                        <div class="form-text small">Final price charged to customer.</div>
                                        <span asp-validation-for="PackagePrice" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Savings Percentage (%)</label>
                                        <div class="input-group">
                                            <input asp-for="SavingsPercent" class="form-control fw-bold text-success" id="savingsPercentInput" type="number" step="0.1" min="0" max="100" placeholder="Auto-calculated" />
                                            <span class="input-group-text">% OFF</span>
                                        </div>
                                        <div class="form-text small">Calculated discount displayed to customer.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="ServiceCatalog" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Save Service Package
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const checkboxes = document.querySelectorAll('.service-checkbox');
        const originalInput = document.getElementById('originalPriceInput');
        const packageInput = document.getElementById('packagePriceInput');
        const savingsInput = document.getElementById('savingsPercentInput');
        const selectedCountBadge = document.getElementById('selectedCountBadge');

        function recalculateTotals() {
            let total = 0;
            let count = 0;
            checkboxes.forEach(cb => {
                if (cb.checked) {
                    total += parseFloat(cb.dataset.price || '0');
                    count++;
                }
            });

            selectedCountBadge.textContent = count + (count === 1 ? ' service selected' : ' services selected');
            originalInput.value = Math.round(total);

            computeSavings();
        }

        function computeSavings() {
            const original = parseFloat(originalInput.value) || 0;
            const pkgPrice = parseFloat(packageInput.value) || 0;

            if (original > 0 && pkgPrice > 0 && pkgPrice < original) {
                const savings = ((original - pkgPrice) / original) * 100;
                savingsInput.value = savings.toFixed(1);
            } else if (pkgPrice >= original && original > 0) {
                savingsInput.value = "0";
            }
        }

        checkboxes.forEach(cb => cb.addEventListener('change', recalculateTotals));
        packageInput.addEventListener('input', computeSavings);
        originalInput.addEventListener('input', computeSavings);

        // Run on initial load
        recalculateTotals();
    </script>
}