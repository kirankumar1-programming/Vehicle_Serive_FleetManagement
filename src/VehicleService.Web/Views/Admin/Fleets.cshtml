@model IReadOnlyList<CompanyFleet>
@{
    ViewData["Title"] = "Corporate Fleets Management";
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-truck text-primary"></i> Corporate Fleets Management</h2>
            <p class="text-muted small mb-0">Manage corporate fleet client accounts, commercial credit budgets, discount rates, and assigned vehicles</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border font-monospace px-3 py-2">
                Total Fleets: @Model.Count
            </span>
            <a asp-action="AddFleet" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> Add Corporate Fleet
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center border-0 shadow-sm">
            <div class="mb-3">
                <i class="bi bi-truck fs-1 text-muted"></i>
            </div>
            <h4>No Corporate Fleets Registered Yet</h4>
            <p class="text-muted">Register corporate client accounts to enable fleet vehicle tracking, corporate discounts, and billing limits.</p>
            <div class="mt-2">
                <a asp-action="AddFleet" class="btn btn-primary">
                    <i class="bi bi-plus-circle-fill me-1"></i> Register First Fleet
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var f in Model)
            {
                <div class="col-lg-6">
                    <div class="card p-4 border-0 shadow-sm h-100 @(!f.IsActive ? "opacity-75 bg-light" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-primary font-monospace fs-6">@f.RegistrationNumber</span>
                                    @if (f.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Active Fleet
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-pause-circle-fill me-1"></i> Inactive
                                        </span>
                                    }
                                </div>
                                <h4 class="fw-bold mt-1 mb-0">@f.CompanyName</h4>
                                <div class="text-muted small mt-1">
                                    <span class="font-monospace"><i class="bi bi-file-text me-1"></i>GSTIN/Tax ID: <strong>@f.TaxId</strong></span>
                                </div>
                                <p class="text-muted small mb-0 mt-1"><i class="bi bi-geo-alt me-1"></i>@f.Address</p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 mb-1">
                                    <i class="bi bi-percent"></i> @f.CorporateDiscountRate% Corp Discount
                                </span>
                                <div>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        Budget: ₹@f.MonthlyBudgetLimit.ToString("N0")/mo
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Contact & Operational Meta -->
                        <div class="p-3 bg-light rounded my-3 small border">
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <div class="text-muted">Primary Contact:</div>
                                    <div class="fw-bold text-dark"><i class="bi bi-person me-1"></i>@f.ContactPerson</div>
                                    <div class="text-secondary"><i class="bi bi-telephone me-1"></i>@f.ContactPhone</div>
                                    <div class="text-secondary"><i class="bi bi-envelope me-1"></i>@f.ContactEmail</div>
                                </div>
                                <div class="col-sm-6 border-start ps-3">
                                    <div class="text-muted">Fleet Asset Statistics:</div>
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span>Registered Vehicles:</span>
                                        <strong class="text-primary font-monospace">@f.Vehicles.Count</strong>
                                    </div>
                                    <div class="d-flex justify-content-between py-1">
                                        <span>Managers & Drivers:</span>
                                        <strong class="text-dark font-monospace">@f.ManagersAndDrivers.Count</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Toolbar -->
                        <div class="d-flex flex-wrap gap-2 pt-2 border-top align-items-center justify-content-between mt-auto">
                            <div class="d-flex gap-2 align-items-center">
                                <a asp-action="EditFleet" asp-route-id="@f.Id" class="btn btn-primary btn-sm" title="Edit Corporate Fleet Details">
                                    <i class="bi bi-pencil-square me-1"></i> Edit Details
                                </a>
                                <a asp-controller="Fleet" asp-action="Vehicles" asp-route-fleetId="@f.Id" class="btn btn-outline-secondary btn-sm" title="View Vehicles in this fleet">
                                    <i class="bi bi-truck me-1"></i> View Vehicles (@f.Vehicles.Count)
                                </a>
                            </div>
                            <div>
                                <form asp-action="ToggleFleetStatus" asp-route-id="@f.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (f.IsActive)
                                    {
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Deactivate Fleet" onclick="return confirm('Deactivate @f.CompanyName? Inactive fleets cannot receive corporate discounts or register new vehicles.');">
                                            <i class="bi bi-pause-circle me-1"></i> Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-success btn-sm" title="Activate Fleet">
                                            <i class="bi bi-play-circle me-1"></i> Activate
                                        </button>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
