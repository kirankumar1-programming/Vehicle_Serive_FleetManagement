@model DashboardMetricsDto
@{
    ViewData["Title"] = "Administrator System Overview";
    var serviceMetrics = ViewBag.ServiceMetrics as ServiceMetricsDto;
    var recentLogs = ViewBag.RecentLogs as IReadOnlyList<AuditLogDto> ?? new List<AuditLogDto>();
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-primary"></i> Master Administration Console</h2>
            <p class="text-muted small mb-0">Platform-wide overview, revenue KPIs, service bay utilization & audit trail</p>
        </div>
    </div>

    <!-- Master KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="stat-icon primary"><i class="bi bi-people-fill"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.TotalCustomers</h3>
                    <div class="text-muted small">Active Customers</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="stat-icon info"><i class="bi bi-car-front-fill"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.TotalVehicles</h3>
                    <div class="text-muted small">Registered Vehicles</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="stat-icon warning"><i class="bi bi-wrench"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">@Model.ActiveJobs</h3>
                    <div class="text-muted small">Active Workshop Jobs</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="stat-icon success"><i class="bi bi-currency-rupee"></i></div>
                <div>
                    <h3 class="fw-bold mb-0">₹@Model.TotalRevenue.ToString("N0")</h3>
                    <div class="text-muted small">Total Platform Revenue</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Popular Services -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-star-fill text-warning"></i> Most Requested Services</h5>
                @if (serviceMetrics?.PopularServices.Any() == true)
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var p in serviceMetrics.PopularServices)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><strong>@p.ServiceName</strong></span>
                                <span class="badge bg-primary rounded-pill">@p.RequestCount bookings</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Recent System Audit Logs -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-fingerprint text-primary"></i> Administrative Audit Trail</h5>
                    <a asp-action="AuditLogs" class="btn btn-sm btn-link p-0">View all &rarr;</a>
                </div>
                @if (recentLogs.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var l in recentLogs)
                        {
                            <li class="list-group-item px-0 py-2">
                                <div class="d-flex justify-content-between">
                                    <span><strong>@l.Action</strong> on @l.EntityName</span>
                                    <small class="text-muted">@l.Timestamp.ToString("HH:mm")</small>
                                </div>
                                <small class="text-muted">By @(l.UserName ?? "System")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small">Audit logging engine active.</p>
                }
            </div>
        </div>
    </div>
</div>