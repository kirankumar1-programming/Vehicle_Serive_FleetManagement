@model List<VehicleService.Application.DTOs.DocumentSummaryDto>
@{
    ViewData["Title"] = "AI Knowledge Base & RAG Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-cpu-fill text-primary"></i> AI Knowledge Base (RAG)</h2>
            <p class="text-secondary mb-0">Manage pre-loaded service manuals, warranty policies, and custom documents indexed into the AutoBot RAG pipeline.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Ingest New Document
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- RAG Interactive Test Sandbox -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-2"><i class="bi bi-search text-primary me-2"></i> RAG Interactive Retrieval Inspector</h5>
            <p class="text-muted small mb-3">Test any user question to inspect the real-time BM25 chunk retrieval scores, database record extractions, and synthesized answer generated by the hybrid RAG orchestrator.</p>
            <div class="input-group mb-3">
                <input id="ragTestInput" type="text" class="form-control form-control-lg" placeholder="e.g. When should I replace brake pads? or Check low stock inventory" />
                <button id="ragTestBtn" class="btn btn-primary btn-lg px-4" type="button">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Inspect RAG Pipeline
                </button>
            </div>

            <!-- Sandbox Results Display Area -->
            <div id="ragResultsArea" class="d-none mt-3">
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="card h-100 border-0 shadow-xs">
                            <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-file-earmark-text text-success me-1"></i> Matched Document Chunks</span>
                                <span id="detectedIntentBadge" class="badge bg-primary">Intent</span>
                            </div>
                            <div id="docChunksContainer" class="card-body p-3" style="max-height: 340px; overflow-y: auto;">
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card h-100 border-0 shadow-xs">
                            <div class="card-header bg-white fw-bold">
                                <i class="bi bi-database text-info me-1"></i> Matched Live Database Records
                            </div>
                            <div id="dbRecordsContainer" class="card-body p-3" style="max-height: 340px; overflow-y: auto;">
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card border-0 shadow-xs">
                            <div class="card-header bg-white fw-bold">
                                <i class="bi bi-robot text-primary me-1"></i> Final Synthesized AI Output
                            </div>
                            <div id="synthesizedOutput" class="card-body p-3 bg-white" style="white-space: pre-wrap; font-family: inherit;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Document Store Grid -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Indexed Knowledge Documents (@Model.Count)</h5>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">Active RAG Index</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Document Title</th>
                        <th>Category</th>
                        <th>Chunks</th>
                        <th>File Name</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@doc.Title</div>
                                <small class="text-muted">@doc.Description</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@doc.Category</span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    <i class="bi bi-layers me-1"></i> @doc.ChunkCount Chunks
                                </span>
                            </td>
                            <td><code class="small text-muted">@doc.FileName</code></td>
                            <td>@doc.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <form asp-action="DeleteDocument" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this document from the RAG knowledge base?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@doc.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Document">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Upload / Paste Document Modal -->
<div class="modal fade" id="uploadDocModal" tabindex="-1" aria-labelledby="uploadDocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="uploadDocModalLabel"><i class="bi bi-cloud-upload me-2 text-primary"></i> Ingest New Knowledge Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Document Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Brake Maintenance SOP 2026" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="Category" class="form-select">
                                <option value="Maintenance">Maintenance & Service</option>
                                <option value="Warranty">Warranty & Claims</option>
                                <option value="Roadside">Roadside & Safety</option>
                                <option value="Fleet">Fleet Operations</option>
                                <option value="Pricing">Pricing & Packages</option>
                                <option value="FAQ">Customer FAQ</option>
                                <option value="General" selected>General</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Upload File (Optional: .txt, .md, .pdf)</label>
                            <input type="file" name="file" class="form-control" accept=".txt,.md,.pdf,.json" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Short Description</label>
                        <input type="text" name="Description" class="form-control" placeholder="Brief summary of document contents" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Or Paste Raw Content / Markdown Text</label>
                        <textarea name="Content" class="form-control font-monospace" rows="8" placeholder="Paste manual content or Markdown text here..."></textarea>
                        <small class="text-muted">Use markdown headers (#, ##) to structure semantic chunks automatically.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Ingest & Index Document</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('ragTestBtn').addEventListener('click', async function () {
            const query = document.getElementById('ragTestInput').value.trim();
            if (!query) return;

            const resultsArea = document.getElementById('ragResultsArea');
            const docChunksContainer = document.getElementById('docChunksContainer');
            const dbRecordsContainer = document.getElementById('dbRecordsContainer');
            const synthesizedOutput = document.getElementById('synthesizedOutput');
            const intentBadge = document.getElementById('detectedIntentBadge');

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Searching...';

            try {
                const resp = await fetch('/Chatbot/TestRag', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: query })
                });

                if (!resp.ok) throw new Error('Failed to run RAG test');
                const data = await resp.json();

                resultsArea.classList.remove('d-none');
                intentBadge.innerText = data.detectedIntent || 'General';

                // Render Chunks
                if (data.matchedDocuments && data.matchedDocuments.length > 0) {
                    let docHtml = '';
                    data.matchedDocuments.forEach(c => {
                        docHtml += `
                            <div class="p-2 mb-2 rounded bg-light border">
                                <div class="d-flex justify-content-between">
                                    <strong class="text-primary small">${c.documentTitle}</strong>
                                    <span class="badge bg-success">Score: ${c.score}</span>
                                </div>
                                <div class="text-muted small mb-1">Section: <em>${c.sectionTitle}</em></div>
                                <div class="small text-secondary" style="font-size: 0.8rem;">${c.chunkText.substring(0, 160)}...</div>
                            </div>
                        `;
                    });
                    docChunksContainer.innerHTML = docHtml;
                } else {
                    docChunksContainer.innerHTML = '<div class="text-muted small">No document chunks exceeded the relevance threshold.</div>';
                }

                // Render DB Records
                if (data.matchedDatabaseRecords && data.matchedDatabaseRecords.length > 0) {
                    let dbHtml = '<ul class="list-unstyled mb-0">';
                    data.matchedDatabaseRecords.forEach(r => {
                        dbHtml += `<li class="small p-1 border-bottom"><i class="bi bi-arrow-right-short text-primary"></i> ${r}</li>`;
                    });
                    dbHtml += '</ul>';
                    dbRecordsContainer.innerHTML = dbHtml;
                } else {
                    dbRecordsContainer.innerHTML = '<div class="text-muted small">No specific live database records matched this query.</div>';
                }

                synthesizedOutput.innerText = data.synthesizedAnswer || 'No response generated.';
            } catch (err) {
                alert('RAG Inspection failed: ' + err.message);
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-lightning-charge-fill me-1"></i> Inspect RAG Pipeline';
            }
        });
    </script>
}
