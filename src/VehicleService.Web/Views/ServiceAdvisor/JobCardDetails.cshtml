@model JobCardDto
@{
    ViewData["Title"] = $"Job Card - {Model.JobCardNumber}";
    var inspection = ViewBag.Inspection as VehicleInspection;
    var estimate = ViewBag.Estimate as RepairEstimateDto;
    var mechanics = ViewBag.Mechanics as IList<ApplicationUser> ?? new List<ApplicationUser>();
    var parts = ViewBag.Parts as IReadOnlyList<InventoryPartDto> ?? new List<InventoryPartDto>();
    var bays = ViewBag.Bays as IList<ServiceBay> ?? new List<ServiceBay>();
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary font-monospace fs-6">@Model.JobCardNumber</span>
            <h2 class="fw-bold mb-0 mt-2">@Model.VehicleInfo</h2>
            <p class="text-muted small mb-0">Customer: <strong>@Model.CustomerName</strong> (@Model.CustomerPhone) | Odometer In: <strong>@Model.OdometerIn.ToString("N0") KM</strong> @(Model.OdometerOut.HasValue ? $"| Out: {Model.OdometerOut.Value:N0} KM" : "")</p>
        </div>
        @if (Model.Status != AppointmentStatus.Completed && Model.Status != AppointmentStatus.Cancelled)
        {
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editAdvisorJobModal">
                    <i class="bi bi-pencil-square"></i> Edit Details
                </button>
                @if (estimate == null)
                {
                    <a asp-action="CreateEstimate" asp-route-jobCardId="@Model.Id" class="btn btn-warning fw-semibold">
                        <i class="bi bi-calculator"></i> Prepare Repair Estimate
                    </a>
                }
                <a asp-controller="Finance" asp-action="GenerateInvoice" asp-route-jobCardId="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-receipt"></i> Generate Invoice
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelAdvisorJobModal">
                    <i class="bi bi-x-circle"></i> Cancel Job Card
                </button>
            </div>
        }
    </div>

    @if (Model.Status == AppointmentStatus.Cancelled)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4">
            <i class="bi bi-x-octagon-fill fs-3 me-3"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">Job Card Cancelled</h5>
                <p class="mb-0 small">This job card is cancelled. Editing details, preparing estimates, generating invoices, and mechanic reassignments are disabled.</p>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Advisor Control Panel -->
        <div class="col-lg-4">
            <div class="card p-4 border-0 shadow-sm mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-person-gear text-primary"></i> Assignment & Bay Control</h5>
                @if (Model.Status != AppointmentStatus.Completed && Model.Status != AppointmentStatus.Cancelled)
                {
                    <form asp-action="AssignMechanic" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobCardId" value="@Model.Id" />
                        <label class="form-label small fw-semibold">Assigned Mechanic</label>
                        <div class="input-group">
                            <select name="mechanicId" class="form-select form-select-sm" required>
                                @foreach (var m in mechanics)
                                {
                                    <option value="@m.Id" selected="@(Model.MechanicId == m.Id)">@m.FullName</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Assign</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="mb-3 small">
                        <span class="text-muted fw-semibold">Assigned Mechanic:</span>
                        <strong>@(Model.MechanicName ?? "None")</strong>
                    </div>
                }

                <div class="small border-top pt-2">
                    <div><strong>Service Bay:</strong> @(Model.ServiceBayName ?? "General Bay")</div>
                    <div><strong>Status:</strong> <span class="badge-status @Model.Status.ToString().ToLower()">@Model.Status</span></div>
                </div>
            </div>

            <!-- Estimate Status Card -->
            @if (estimate != null)
            {
                <div class="card p-4 border-0 shadow-sm">
                    <h5 class="fw-bold mb-2"><i class="bi bi-calculator text-warning"></i> Estimate @estimate.EstimateNumber</h5>
                    <div class="fs-4 fw-bold text-primary mb-2">₹@estimate.GrandTotal.ToString("N2")</div>
                    <span class="badge @(estimate.ApprovalStatus == EstimateApprovalStatus.Approved ? "bg-success" : "bg-warning text-dark") fs-6 mb-2">
                        @estimate.ApprovalStatus
                    </span>
                    <p class="small text-muted mb-0">Customer Response: <em>@(estimate.CustomerNotes ?? "Pending")</em></p>
                </div>
            }
        </div>

        <!-- Inspection & Work History -->
        <div class="col-lg-8">
            <div class="card p-4 border-0 shadow-sm mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-clipboard-pulse text-danger"></i> 40-Point Inspection Details</h5>
                @if (inspection != null)
                {
                    <div class="row g-2 small">
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Engine:</strong> @inspection.EngineCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Brakes:</strong> @inspection.BrakeCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Tyres:</strong> @inspection.TyreCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Battery:</strong> @inspection.BatteryCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Fluids:</strong> @inspection.FluidLevels</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Fuel:</strong> @inspection.FuelLevel</div>
                    </div>
                    @if (!string.IsNullOrEmpty(inspection.InspectionSummary))
                    {
                        <div class="mt-3 p-2 bg-light border-start border-3 border-primary small">
                            <strong>Summary:</strong> @inspection.InspectionSummary
                        </div>
                    }
                }
            </div>

            <div class="card p-4 border-0 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-wrench text-primary"></i> Work Logs & Replaced Parts</h5>
                <h6>Parts Consumed:</h6>
                @if (Model.ConsumedParts.Any())
                {
                    <ul class="list-group list-group-flush small mb-3">
                        @foreach (var p in Model.ConsumedParts)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0 py-1">
                                <span>@p.PartName (@p.PartNumber) x @p.Quantity</span>
                                <strong>₹@p.LineTotal.ToString("N2")</strong>
                            </li>
                        }
                    </ul>
                }
                else { <p class="text-muted small">No parts logged yet.</p> }

                <h6>Labor Activity:</h6>
                @if (Model.WorkLogs.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var w in Model.WorkLogs)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0 py-1">
                                <span>@w.TaskDescription (@w.MechanicName)</span>
                                <span class="badge bg-secondary">@w.HoursSpent hrs</span>
                            </li>
                        }
                    </ul>
                }
                else { <p class="text-muted small">No work logs recorded.</p> }
            </div>

            <div class="card p-4 border-0 shadow-sm mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-file-text text-primary"></i> Observations & Recommendations</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editAdvisorJobModal">
                        <i class="bi bi-pencil-square"></i> Edit Details
                    </button>
                </div>
                <div class="row g-3 small">
                    <div class="col-md-6">
                        <strong>Advisor Observations:</strong>
                        <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.AdvisorObservations) ? "None recorded." : Model.AdvisorObservations)</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Customer Recommendations:</strong>
                        <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Recommendations) ? "None." : Model.Recommendations)</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Mechanic Notes:</strong>
                        <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.MechanicNotes) ? "None." : Model.MechanicNotes)</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Quality Check Notes:</strong>
                        <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.QualityCheckNotes) ? "None." : Model.QualityCheckNotes)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Status != AppointmentStatus.Completed && Model.Status != AppointmentStatus.Cancelled)
{
    <!-- Edit Job Card Modal (Service Advisor) -->
    <div class="modal fade" id="editAdvisorJobModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square"></i> Edit Job Card @Model.JobCardNumber</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="UpdateDetails" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="JobCardId" value="@Model.Id" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Service Bay Assignment</label>
                                <select name="ServiceBayId" class="form-select">
                                    <option value="">-- No Specific Bay / Released --</option>
                                    @foreach (var b in bays)
                                    {
                                        <option value="@b.Id" selected="@(Model.ServiceBayId == b.Id)">@b.BayName (@b.BayNumber)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Assigned Mechanic</label>
                                <select name="MechanicId" class="form-select">
                                    <option value="">-- Unassigned --</option>
                                    @foreach (var m in mechanics)
                                    {
                                        <option value="@m.Id" selected="@(Model.MechanicId == m.Id)">@m.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Odometer In (KM)</label>
                                <input type="number" name="OdometerIn" class="form-control" value="@Model.OdometerIn" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Odometer Out (KM)</label>
                                <input type="number" name="OdometerOut" class="form-control" value="@Model.OdometerOut" min="@Model.OdometerIn" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Status Stage</label>
                                <select name="Status" class="form-select">
                                    <option value="@AppointmentStatus.VehicleReceived" selected="@(Model.Status == AppointmentStatus.VehicleReceived)">Vehicle Received</option>
                                    <option value="@AppointmentStatus.UnderInspection" selected="@(Model.Status == AppointmentStatus.UnderInspection)">Under Inspection</option>
                                    <option value="@AppointmentStatus.InProgress" selected="@(Model.Status == AppointmentStatus.InProgress)">In Progress</option>
                                    <option value="@AppointmentStatus.QualityCheck" selected="@(Model.Status == AppointmentStatus.QualityCheck)">Quality Check</option>
                                    <option value="@AppointmentStatus.ReadyForDelivery" selected="@(Model.Status == AppointmentStatus.ReadyForDelivery)">Ready For Delivery</option>
                                    <option value="@AppointmentStatus.Completed" selected="@(Model.Status == AppointmentStatus.Completed)">Completed</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Advisor Observations</label>
                                <textarea name="AdvisorObservations" class="form-control" rows="2" placeholder="Initial customer complaints or check-in notes...">@Model.AdvisorObservations</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Recommendations for Customer</label>
                                <textarea name="Recommendations" class="form-control" rows="2" placeholder="Future service or preventative maintenance advice...">@Model.Recommendations</textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mechanic Notes</label>
                                <textarea name="MechanicNotes" class="form-control" rows="2">@Model.MechanicNotes</textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Quality Check Notes</label>
                                <textarea name="QualityCheckNotes" class="form-control" rows="2">@Model.QualityCheckNotes</textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Cancel Job Card Modal (Service Advisor) -->
    <div class="modal fade" id="cancelAdvisorJobModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-octagon"></i> Cancel Job Card @Model.JobCardNumber</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="CancelJobCard" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobCardId" value="@Model.Id" />
                    <div class="modal-body">
                        <div class="alert alert-warning small mb-3">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            <strong>Automatic Rollback:</strong> Cancelling this job card will automatically release all reserved spare parts back to available inventory and free up <strong>@(Model.ServiceBayName ?? "the service bay")</strong>.
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Reason for Cancellation *</label>
                            <textarea name="reason" class="form-control" rows="3" placeholder="Please specify reason for cancellation..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle"></i> Confirm Cancellation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}