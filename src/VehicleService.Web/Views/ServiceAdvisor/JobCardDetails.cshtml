@model JobCardDto
@{
    ViewData["Title"] = $"Job Card - {Model.JobCardNumber}";
    var inspection = ViewBag.Inspection as VehicleInspection;
    var estimate = ViewBag.Estimate as RepairEstimateDto;
    var mechanics = ViewBag.Mechanics as IList<ApplicationUser> ?? new List<ApplicationUser>();
    var parts = ViewBag.Parts as IReadOnlyList<InventoryPartDto> ?? new List<InventoryPartDto>();
}

<div class="container-fluid px-lg-4 my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary font-monospace fs-6">@Model.JobCardNumber</span>
            <h2 class="fw-bold mb-0 mt-2">@Model.VehicleInfo</h2>
            <p class="text-muted small mb-0">Customer: <strong>@Model.CustomerName</strong> (@Model.CustomerPhone) | Odometer In: <strong>@Model.OdometerIn.ToString("N0") KM</strong></p>
        </div>
        <div class="d-flex gap-2">
            @if (estimate == null)
            {
                <a asp-action="CreateEstimate" asp-route-jobCardId="@Model.Id" class="btn btn-warning fw-semibold">
                    <i class="bi bi-calculator"></i> Prepare Repair Estimate
                </a>
            }
            <a asp-controller="Finance" asp-action="GenerateInvoice" asp-route-jobCardId="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-receipt"></i> Generate Invoice
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Advisor Control Panel -->
        <div class="col-lg-4">
            <div class="card p-4 border-0 shadow-sm mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-person-gear text-primary"></i> Assignment & Bay Control</h5>
                <form asp-action="AssignMechanic" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobCardId" value="@Model.Id" />
                    <label class="form-label small fw-semibold">Assigned Mechanic</label>
                    <div class="input-group">
                        <select name="mechanicId" class="form-select form-select-sm" required>
                            @foreach (var m in mechanics)
                            {
                                <option value="@m.Id" selected="@(Model.MechanicId == m.Id)">@m.FullName</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Assign</button>
                    </div>
                </form>

                <div class="small border-top pt-2">
                    <div><strong>Service Bay:</strong> @(Model.ServiceBayName ?? "General Bay")</div>
                    <div><strong>Status:</strong> <span class="badge-status @Model.Status.ToString().ToLower()">@Model.Status</span></div>
                </div>
            </div>

            <!-- Estimate Status Card -->
            @if (estimate != null)
            {
                <div class="card p-4 border-0 shadow-sm">
                    <h5 class="fw-bold mb-2"><i class="bi bi-calculator text-warning"></i> Estimate @estimate.EstimateNumber</h5>
                    <div class="fs-4 fw-bold text-primary mb-2">₹@estimate.GrandTotal.ToString("N2")</div>
                    <span class="badge @(estimate.ApprovalStatus == EstimateApprovalStatus.Approved ? "bg-success" : "bg-warning text-dark") fs-6 mb-2">
                        @estimate.ApprovalStatus
                    </span>
                    <p class="small text-muted mb-0">Customer Response: <em>@(estimate.CustomerNotes ?? "Pending")</em></p>
                </div>
            }
        </div>

        <!-- Inspection & Work History -->
        <div class="col-lg-8">
            <div class="card p-4 border-0 shadow-sm mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-clipboard-pulse text-danger"></i> 40-Point Inspection Details</h5>
                @if (inspection != null)
                {
                    <div class="row g-2 small">
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Engine:</strong> @inspection.EngineCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Brakes:</strong> @inspection.BrakeCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Tyres:</strong> @inspection.TyreCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Battery:</strong> @inspection.BatteryCondition</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Fluids:</strong> @inspection.FluidLevels</div>
                        <div class="col-md-4 p-2 bg-light rounded"><strong>Fuel:</strong> @inspection.FuelLevel</div>
                    </div>
                    @if (!string.IsNullOrEmpty(inspection.InspectionSummary))
                    {
                        <div class="mt-3 p-2 bg-light border-start border-3 border-primary small">
                            <strong>Summary:</strong> @inspection.InspectionSummary
                        </div>
                    }
                }
            </div>

            <div class="card p-4 border-0 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-wrench text-primary"></i> Work Logs & Replaced Parts</h5>
                <h6>Parts Consumed:</h6>
                @if (Model.ConsumedParts.Any())
                {
                    <ul class="list-group list-group-flush small mb-3">
                        @foreach (var p in Model.ConsumedParts)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0 py-1">
                                <span>@p.PartName (@p.PartNumber) x @p.Quantity</span>
                                <strong>₹@p.LineTotal.ToString("N2")</strong>
                            </li>
                        }
                    </ul>
                }
                else { <p class="text-muted small">No parts logged yet.</p> }

                <h6>Labor Activity:</h6>
                @if (Model.WorkLogs.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var w in Model.WorkLogs)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0 py-1">
                                <span>@w.TaskDescription (@w.MechanicName)</span>
                                <span class="badge bg-secondary">@w.HoursSpent hrs</span>
                            </li>
                        }
                    </ul>
                }
                else { <p class="text-muted small">No work logs recorded.</p> }
            </div>
        </div>
    </div>
</div>